{
  "name": "sabris.com",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/studio typecheck",
    "format": "prettier --write .",
    "studio": "bun run --cwd apps/studio dev"
  },
  "devDependencies": {
    "prettier": "^3.7.3"
  }
}
